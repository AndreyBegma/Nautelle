{
  "schemaVersion": 1,
  "name": "Accept dialog: pick the action, then see only its options",
  "description": "C-380: the Accept dialog shows an action selector when the pull request can be merged, only the selected path's options, and one primary button.",
  "viewport": { "width": 1440, "height": 900 },
  "steps": [
    { "action": "marker", "title": "Sign in" },
    { "action": "navigate", "path": "/login?next=/projects/demo-project/board" },
    { "action": "wait", "ms": 3000 },
    {
      "action": "fill",
      "target": { "label": "Email" },
      "valueFrom": { "env": "DEMO_LOGIN_EMAIL" }
    },
    {
      "action": "fill",
      "target": { "label": "Password" },
      "valueFrom": { "env": "DEMO_LOGIN_PASSWORD" }
    },
    { "action": "click", "target": { "role": "button", "name": "Sign in" } },
    { "action": "marker", "title": "Open Accept on a finished card" },
    {
      "action": "click",
      "target": { "role": "button", "name": "Accept" },
      "caption": "Accept on a finished card with a pull request.",
      "timeoutMs": 30000
    },
    {
      "action": "waitFor",
      "target": { "role": "dialog" },
      "caption": "The dialog shows the pull request, then the action selector.",
      "timeoutMs": 15000
    },
    { "action": "screenshot", "name": "accept-merge-path" },
    { "action": "marker", "title": "Switch to no merge" },
    {
      "action": "click",
      "target": { "role": "button", "name": "Accept without merging" },
      "caption": "Only the leave-open or close choice remains."
    },
    { "action": "wait", "ms": 1000 },
    { "action": "screenshot", "name": "accept-no-merge-path" }
  ]
}
