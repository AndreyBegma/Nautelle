{
  "schemaVersion": 1,
  "name": "Triggers and Webhooks follow deliveries live",
  "setup": [
    {
      "action": "include",
      "fragment": "sign-in",
      "with": {
        "next": "/admin/integrations/triggers"
      }
    }
  ],
  "steps": [
    {
      "action": "marker",
      "title": "Triggers list follows the admin topic, no 15 s poll"
    },
    {
      "action": "assertText",
      "target": {
        "role": "heading",
        "name": "Triggers",
        "exact": true
      },
      "text": "Triggers",
      "match": "exact",
      "timeoutMs": 30000
    },
    {
      "action": "wait",
      "ms": 2000
    },
    {
      "action": "marker",
      "title": "Webhooks list reloads on a delivery event"
    },
    {
      "action": "navigate",
      "path": "/admin/integrations/webhooks"
    },
    {
      "action": "assertText",
      "target": {
        "role": "heading",
        "name": "Webhooks",
        "exact": true
      },
      "text": "Webhooks",
      "match": "exact",
      "timeoutMs": 30000
    },
    {
      "action": "wait",
      "ms": 2000
    }
  ]
}
