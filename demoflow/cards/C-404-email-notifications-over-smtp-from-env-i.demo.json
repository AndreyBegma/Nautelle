{
  "schemaVersion": 1,
  "name": "Email notifications over SMTP from the environment",
  "description": "Admin › Integrations lists Email, whose page shows the SMTP server from SMTP_URL and the test send; Account › Notifications gets an Email card. The demo server has no SMTP_URL, so both show how email is turned on.",
  "steps": [
    { "action": "marker", "title": "Sign in" },
    { "action": "navigate", "path": "/login?next=/admin/integrations" },
    {
      "action": "waitFor",
      "target": { "role": "button", "name": "Sign in" },
      "timeoutMs": 60000
    },
    { "action": "wait", "ms": 5000 },
    {
      "action": "fill",
      "target": { "label": "Email" },
      "valueFrom": { "env": "DEMO_LOGIN_EMAIL" }
    },
    {
      "action": "fill",
      "target": { "label": "Password" },
      "valueFrom": { "env": "DEMO_LOGIN_PASSWORD" }
    },
    { "action": "click", "target": { "role": "button", "name": "Sign in" } },
    {
      "action": "waitFor",
      "target": { "role": "heading", "name": "Integrations", "exact": true },
      "timeoutMs": 60000
    },
    { "action": "marker", "title": "Email among the integrations" },
    {
      "action": "assertVisible",
      "target": {
        "text": "Notifications by email, at once or as a daily digest"
      },
      "timeoutMs": 30000,
      "zoom": true
    },
    { "action": "wait", "ms": 2000 },
    { "action": "marker", "title": "The Email integration page" },
    { "action": "navigate", "path": "/admin/integrations/email" },
    {
      "action": "waitFor",
      "target": { "role": "heading", "name": "Email", "exact": true },
      "timeoutMs": 60000
    },
    {
      "action": "assertVisible",
      "target": { "text": "No SMTP_URL on the server" },
      "timeoutMs": 30000,
      "zoom": true
    },
    {
      "action": "assertVisible",
      "target": { "role": "heading", "name": "Status", "exact": true },
      "timeoutMs": 30000
    },
    { "action": "wait", "ms": 2000 },
    { "action": "marker", "title": "Email in Account › Notifications" },
    { "action": "navigate", "path": "/account/notifications" },
    {
      "action": "waitFor",
      "target": { "role": "heading", "name": "Notifications", "exact": true },
      "timeoutMs": 60000
    },
    {
      "action": "scroll",
      "target": { "role": "heading", "name": "Email", "exact": true }
    },
    {
      "action": "assertVisible",
      "target": { "text": "Email is not set up on this server." },
      "timeoutMs": 30000,
      "zoom": true
    },
    { "action": "wait", "ms": 2000 }
  ]
}
