{
  "schemaVersion": 1,
  "name": "Password and 2FA reset links",
  "description": "The demo server has no SMTP_URL, so the sign-in page and Forgot password tell a locked-out person to ask an administrator. The admin opens Admin › Users and creates a one-time password reset link for a teammate, shown once. A link that is missing, used or expired opens as not valid.",
  "steps": [
    { "action": "marker", "title": "Without email, ask an administrator" },
    { "action": "navigate", "path": "/login?next=/admin/users" },
    {
      "action": "waitFor",
      "target": { "role": "button", "name": "Sign in" },
      "timeoutMs": 60000
    },
    { "action": "wait", "ms": 5000 },
    {
      "action": "assertVisible",
      "target": {
        "text": "Forgot your password? Ask an administrator for a reset link."
      },
      "timeoutMs": 30000,
      "zoom": true
    },
    { "action": "wait", "ms": 2000 },
    { "action": "navigate", "path": "/forgot-password" },
    {
      "action": "waitFor",
      "target": { "text": "Ask an administrator", "exact": true },
      "timeoutMs": 60000
    },
    {
      "action": "assertVisible",
      "target": {
        "text": "An administrator can give you a one-time reset link from Admin › Users."
      },
      "timeoutMs": 30000,
      "zoom": true
    },
    { "action": "wait", "ms": 2000 },
    { "action": "marker", "title": "Sign in as the admin" },
    { "action": "navigate", "path": "/login?next=/admin/users" },
    {
      "action": "waitFor",
      "target": { "role": "button", "name": "Sign in" },
      "timeoutMs": 60000
    },
    {
      "action": "fill",
      "target": { "label": "Email" },
      "valueFrom": { "env": "DEMO_LOGIN_EMAIL" }
    },
    {
      "action": "fill",
      "target": { "label": "Password" },
      "valueFrom": { "env": "DEMO_LOGIN_PASSWORD" }
    },
    { "action": "click", "target": { "role": "button", "name": "Sign in" } },
    {
      "action": "waitFor",
      "target": { "role": "heading", "name": "Users", "exact": true },
      "timeoutMs": 60000
    },
    { "action": "marker", "title": "A reset link from Admin › Users" },
    {
      "action": "assertVisible",
      "target": { "text": "sam@acme.example" },
      "timeoutMs": 30000
    },
    {
      "action": "click",
      "target": { "role": "button", "name": "Reset password" }
    },
    {
      "action": "waitFor",
      "target": { "text": "Create a password reset link?" },
      "timeoutMs": 30000
    },
    { "action": "wait", "ms": 1500 },
    {
      "action": "click",
      "target": { "role": "button", "name": "Create link" }
    },
    {
      "action": "waitFor",
      "target": { "text": "Password reset link", "exact": true },
      "timeoutMs": 30000
    },
    {
      "action": "assertVisible",
      "target": {
        "text": "This is the only time you will see it."
      },
      "timeoutMs": 30000,
      "zoom": true
    },
    { "action": "screenshot", "name": "reset-link-dialog" },
    { "action": "wait", "ms": 2000 },
    { "action": "click", "target": { "role": "button", "name": "Done" } },
    { "action": "marker", "title": "A link that is not valid" },
    { "action": "navigate", "path": "/reset-password" },
    {
      "action": "waitFor",
      "target": { "text": "Link not valid", "exact": true },
      "timeoutMs": 60000
    },
    {
      "action": "assertVisible",
      "target": {
        "text": "This reset link has expired or was already used. Ask for a new one."
      },
      "timeoutMs": 30000,
      "zoom": true
    },
    { "action": "wait", "ms": 2000 }
  ]
}
