{
  "schemaVersion": 1,
  "name": "A merged card completes itself and Needs you clears itself",
  "setup": [
    {
      "action": "include",
      "fragment": "sign-in",
      "with": {
        "next": "/projects/demo-project/board"
      }
    }
  ],
  "steps": [
    {
      "action": "waitFor",
      "target": {
        "text": "To Do",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 30000
    },
    {
      "action": "marker",
      "title": "A card whose pull request merged moves to Completed by itself"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Expand Completed"
      }
    },
    {
      "action": "waitFor",
      "target": {
        "text": "Coupon codes at checkout"
      },
      "state": "visible",
      "timeoutMs": 60000
    },
    {
      "action": "assertVisible",
      "target": {
        "text": "PR #42 · Merged"
      }
    },
    {
      "action": "screenshot",
      "name": "merged-card-in-completed"
    },
    {
      "action": "wait",
      "ms": 2000
    },
    {
      "action": "marker",
      "title": "Needs you lists only what still needs a person"
    },
    {
      "action": "navigate",
      "path": "/"
    },
    {
      "action": "waitFor",
      "target": {
        "text": "Needs you",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 30000
    },
    {
      "action": "assertVisible",
      "target": {
        "text": "C-2 Dark mode for the settings page"
      }
    },
    {
      "action": "waitFor",
      "target": {
        "text": "Steward digest"
      },
      "state": "hidden",
      "timeoutMs": 5000
    },
    {
      "action": "screenshot",
      "name": "needs-you-without-service-failure"
    },
    {
      "action": "wait",
      "ms": 2000
    },
    {
      "action": "marker",
      "title": "The Steward failure stays in the project's history"
    },
    {
      "action": "navigate",
      "path": "/projects/demo-project/history"
    },
    {
      "action": "waitFor",
      "target": {
        "text": "Steward digest"
      },
      "state": "visible",
      "timeoutMs": 30000
    },
    {
      "action": "screenshot",
      "name": "steward-failure-in-history"
    },
    {
      "action": "wait",
      "ms": 2000
    }
  ]
}
